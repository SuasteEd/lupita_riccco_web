# Copia este archivo como .env y pega tus valores reales.
# .env está en .gitignore — nunca se sube a GitHub.
# Ninguno de estos valores es secreto en el sentido de una API key de
# backend (ver comentario en src/config/firebase.ts), pero se mantienen
# fuera del código por buena práctica y para no disparar los escáneres
# automáticos de "secretos hardcodeados" de GitHub.

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
